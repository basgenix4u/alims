{
  "name": "alims",
  "version": "0.1.0",
  "private": true,
  "description": "ALIMS \u2014 The Global Academic Knowledge Infrastructure. Preserve. Connect. Activate.",
  "author": "basgenix4u",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "board:validate": "python3 scripts/validate_board.py",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:verify-audit": "psql \"$DATABASE_MIGRATION_URL\" -c 'SELECT * FROM verify_audit_chain();'"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "prisma": "^6.1.0"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.2.0",
      "glob": ">=10.5.0",
      "js-yaml": ">=4.3.1",
      "lodash": ">=4.18.0",
      "picomatch": ">=4.0.4",
      "tmp": ">=0.2.6",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0",
      "vite": ">=6.4.3",
      "esbuild": ">=0.25.0",
      "qs": ">=6.15.2",
      "body-parser": ">=1.20.6",
      "file-type": ">=21.3.2",
      "webpack": ">=5.104.1",
      "@angular-devkit/core>ajv": ">=8.18.0"
    }
  }
}
