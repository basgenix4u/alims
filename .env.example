# Copy to .env — every provider key switches its adapter from SIMULATION to LIVE
# (server/liveops.js). With no keys set, LiveOps runs in certified simulation mode.

# REQUIRED in production — session signing key. Generate: openssl rand -hex 48
JWT_SECRET=generate-a-long-random-hex-string

# Future data layer (the server currently uses the JSON store in server/data/db.json;
# server/production.prisma is ready for a Postgres migration).
DATABASE_URL=postgresql://alims:change-me@db:5432/alims
REDIS_URL=redis://redis:6379

# LiveOps provider keys (all optional — simulation mode without them)
NERD_API_KEY=
TURNITIN_API_KEY=
PAYSTACK_SECRET_KEY=
TERMII_API_KEY=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Optional durable image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
