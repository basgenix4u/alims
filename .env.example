# ─── Application ────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────
# App connects as a NON-superuser, NON-BYPASSRLS role so RLS is enforced.
DATABASE_URL=postgresql://alims_app:change_me@localhost:5432/alims?schema=public
DATABASE_MIGRATION_URL=postgresql://alims_owner:change_me@localhost:5432/alims?schema=public

# ─── Redis / Queue ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (S3 compatible) ─────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=alims-documents
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_FILE_SIZE_BYTES=104857600

# ─── Auth & crypto ──────────────────────────────────────────────
# Every secret below must be >= 32 characters and DISTINCT from the others.
# The API refuses to boot in production on a placeholder or a reused value.
# Generate each one separately: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_min_32_chars_long_secret
# Keys the HMAC that protects refresh tokens at rest.
REFRESH_TOKEN_SECRET=change_me_different_32_chars_secret
# Salts IP/user-agent hashes in the audit log so no raw PII is stored.
AUDIT_HASH_SALT=change_me_another_distinct_32_chars_salt

# TTLs in seconds. The API contract fixes access at 900 and step-up at 300.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
STEP_UP_TTL_SECONDS=300
# Checked on every verify so a token minted elsewhere cannot be replayed here.
JWT_ISSUER=alims.api
JWT_AUDIENCE=alims.web

# Login throttling (PRD 9.1). Lockout is per account; the 5/min rate limit is per IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Refresh cookie. MUST be true in production — the API refuses to boot otherwise.
# Set false only for local HTTP development.
COOKIE_SECURE=true
# Leave blank unless the web app runs on a different subdomain.
COOKIE_DOMAIN=

# Encrypts TOTP secrets at rest (AES-256-GCM). Consumed by T-101.
MFA_ENCRYPTION_KEY=change_me_min_32_chars_long_mfa_key
# 32-byte hex for AES-256-GCM field encryption: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=change_me_64_hex_characters
MFA_ISSUER=ALIMS

# ─── Email ──────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ALIMS <no-reply@alims.local>"

# ─── Similarity provider (advisory only) ────────────────────────
# PRD 6.5: advisory signal. NEVER mutates record status.
SIMILARITY_PROVIDER=stub
SIMILARITY_API_URL=
SIMILARITY_API_KEY=

# ─── Security ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_ANONYMOUS=20
RATE_LIMIT_AUTH_MUTATION=5

# ─── Observability ──────────────────────────────────────────────
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
